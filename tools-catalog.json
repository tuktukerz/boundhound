{
  "$schema": "./docs/tools-catalog.schema.json",
  "version": "0.0.0",
  "categories": ["utility", "recon", "enum"],
  "tools": [
    {
      "tools_name": "curl",
      "description": "HTTP client — Phase 0 bridge test tool only",
      "category": "utility",
      "command": {
        "base": "curl",
        "flags": [
          { "name": "-sS", "type": "boolean", "description": "silent + show errors" },
          { "name": "-I", "type": "boolean", "description": "headers only" }
        ],
        "positional": [
          { "name": "url", "type": "string", "description": "target url", "required": true }
        ]
      },
      "installation": { "linux": { "command": "apt-get install -y curl", "manager": "apt" } },
      "check_installed": { "command": "curl --version", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["utility"],
      "tags": ["http", "bridge-test"],
      "requires_root": false,
      "output_format": ["text"]
    },
    {
      "tools_name": "subfinder",
      "description": "Passive subdomain enumeration",
      "category": "recon",
      "command": {
        "base": "subfinder",
        "target_flag": "-d",
        "flags": [
          { "name": "-silent", "type": "boolean", "description": "silent output" },
          { "name": "-json", "type": "boolean", "description": "JSON lines output" }
        ]
      },
      "installation": {
        "linux": {
          "command": "go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.6",
          "manager": "go"
        }
      },
      "check_installed": { "command": "subfinder -version", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["recon"],
      "tags": ["subdomain-enum", "passive", "dns"],
      "requires_root": false,
      "output_format": ["jsonl"]
    },
    {
      "tools_name": "httpx",
      "description": "HTTP probe with tech/title/status-code detection",
      "category": "recon",
      "command": {
        "base": "httpx",
        "target_flag": "-u",
        "flags": [
          { "name": "-silent", "type": "boolean", "description": "silent output" },
          { "name": "-json", "type": "boolean", "description": "JSON lines output" },
          { "name": "-td", "type": "boolean", "description": "tech detect" },
          { "name": "-title", "type": "boolean", "description": "show page title" },
          { "name": "-sc", "type": "boolean", "description": "show status code" }
        ]
      },
      "installation": {
        "linux": {
          "command": "go install github.com/projectdiscovery/httpx/cmd/httpx@v1.6.9",
          "manager": "go"
        }
      },
      "check_installed": { "command": "httpx -version", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["recon"],
      "tags": ["http-probe", "tech-detect"],
      "requires_root": false,
      "output_format": ["jsonl"]
    },
    {
      "tools_name": "nmap",
      "description": "Port and service/version scan",
      "category": "recon",
      "command": {
        "base": "nmap",
        "flags": [
          { "name": "-sT", "type": "boolean", "description": "TCP connect scan (rootless)" },
          { "name": "-sV", "type": "boolean", "description": "service/version detection" },
          { "name": "-Pn", "type": "boolean", "description": "skip host discovery" },
          { "name": "-T3", "type": "boolean", "description": "normal timing template" },
          { "name": "-T4", "type": "boolean", "description": "aggressive timing template" },
          {
            "name": "-p",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$",
            "description": "port spec"
          },
          {
            "name": "-oG",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^-$",
            "description": "grepable output to stdout"
          }
        ],
        "positional": [
          { "name": "target", "type": "string", "description": "target host/CIDR", "required": true }
        ]
      },
      "installation": { "linux": { "command": "apt-get install -y nmap", "manager": "apt" } },
      "check_installed": { "command": "nmap --version", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["recon"],
      "tags": ["port-scan", "service-detection"],
      "requires_root": false,
      "output_format": ["grepable"]
    },
    {
      "tools_name": "ffuf",
      "description": "Web content/directory discovery via wordlist fuzzing",
      "category": "enum",
      "command": {
        "base": "ffuf",
        "target_flag": "-u",
        "flags": [
          {
            "name": "-w",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^/[A-Za-z0-9._/-]+$",
            "description": "wordlist absolute path"
          },
          {
            "name": "-mc",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]{3}(,[0-9]{3})*$",
            "description": "match HTTP status codes"
          },
          {
            "name": "-fc",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]{3}(,[0-9]{3})*$",
            "description": "filter HTTP status codes"
          },
          {
            "name": "-t",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]+$",
            "description": "threads (also safety-capped)"
          },
          {
            "name": "-rate",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]+$",
            "description": "requests per second (also safety-capped)"
          },
          {
            "name": "-of",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^(json|csv|md|html|ejson)$",
            "description": "output format"
          },
          {
            "name": "-o",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^/[A-Za-z0-9._/-]+$",
            "description": "output file absolute path"
          },
          { "name": "-s", "type": "boolean", "description": "silent mode" }
        ]
      },
      "installation": {
        "linux": {
          "command": "go install github.com/ffuf/ffuf/v2@v2.1.0",
          "manager": "go"
        }
      },
      "check_installed": { "command": "ffuf -V", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["enum"],
      "tags": ["content-discovery", "fuzzing", "brute-force"],
      "requires_root": false,
      "output_format": ["json"]
    },
    {
      "tools_name": "nuclei",
      "description": "Templated detection of known vulnerabilities, misconfigurations, and tech",
      "category": "enum",
      "command": {
        "base": "nuclei",
        "target_flag": "-u",
        "flags": [
          {
            "name": "-t",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[A-Za-z0-9._/-]+$",
            "description": "template path/dir"
          },
          {
            "name": "-severity",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[a-z]+(,[a-z]+)*$",
            "description": "severity filter"
          },
          {
            "name": "-c",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]+$",
            "description": "template concurrency (also safety-capped)"
          },
          {
            "name": "-rl",
            "type": "string",
            "takes_value": true,
            "value_pattern": "^[0-9]+$",
            "description": "rate-limit requests per second (also safety-capped)"
          },
          { "name": "-jsonl", "type": "boolean", "description": "JSON lines output" },
          { "name": "-silent", "type": "boolean", "description": "silent output" },
          {
            "name": "-disable-update-check",
            "type": "boolean",
            "description": "skip template/engine update check (offline-safe)"
          }
        ]
      },
      "installation": {
        "linux": {
          "command": "go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@v3.3.0",
          "manager": "go"
        }
      },
      "check_installed": { "command": "nuclei -version", "exit_code": 0 },
      "skills_loader": "",
      "phase": ["enum"],
      "tags": ["vuln-scan", "detection", "tech-detect"],
      "requires_root": false,
      "output_format": ["jsonl"]
    }
  ]
}
